{
  "name": "igor-computer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A real, persistent computer for AI agents, on your own machine: a Linux desktop and browser that agents drive over MCP and you can step into.",
  "scripts": {
    "start": "node src/service.mjs",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:mac": "bash scripts/build-mac.sh",
    "package:dmg": "bash scripts/package-dmg.sh",
    "test:mac": "bash scripts/test-mac.sh",
    "server:install": "bash scripts/install-server.sh",
    "vm:boot": "bash scripts/start-vm.sh",
    "test:vm": "node tests/vm-live.mjs",
    "test:desktop": "node tests/desktop-live.mjs",
    "cli": "node src/cli.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --offline"
  },
  "dependencies": {
    "@devcontainers/cli": "0.89.0",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-computer-use": "1.0.0",
    "@tanstack/ai-mcp": "1.0.0",
    "chrome-devtools-mcp": "1.12.0",
    "http-proxy": "1.18.1",
    "ws": "8.22.0"
  },
  "bin": {
    "igor-computer": "src/cli.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./tanstack": "./src/tanstack.mjs",
    "./config": "./src/config.mjs"
  }
}
