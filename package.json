{
  "name": "igor-browser",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A persistent headed browser in a private VM, with native macOS human takeover and MCP.",
  "scripts": {
    "start": "node src/service.mjs",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:mac": "bash scripts/build-mac.sh",
    "vm:build": "bash scripts/build-browser.sh",
    "vm:start": "bash scripts/start-browser.sh",
    "package:dmg": "bash scripts/package-dmg.sh",
    "test:mac": "bash scripts/test-mac.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "chrome-devtools-mcp": "1.10.1",
    "http-proxy": "1.18.1"
  },
  "igor": {
    "extension": "./igor.extension.json"
  }
}
